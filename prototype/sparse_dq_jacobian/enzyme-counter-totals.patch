     std::unordered_map<std::string, long> CVODEIntegrator::getSolverStatistics() const {
+        // the totals since resetSolverStatistics, summed over the reinitializations of CVODE
+        std::unordered_map<std::string, long> s = currentSolverStatistics();
+        for (const auto &[k, v]: mSavedSolverStatistics) {
+            s[k] += v;
+        }
+        return s;
+    }
+
+    void CVODEIntegrator::saveSolverStatistics() {
+        for (const auto &[k, v]: currentSolverStatistics()) {
+            if (k != "sparse_linear_solver") {
+                mSavedSolverStatistics[k] += v;
+            }
+        }
+        mLinearSolverCountersCurrent = false;
+    }
+
+    void CVODEIntegrator::resetSolverStatistics() {
+        mSavedSolverStatistics.clear();
+        for (const auto &[k, v]: currentSolverStatistics()) {
+            if (k != "sparse_linear_solver") {
+                mSavedSolverStatistics[k] = -v;
+            }
+        }
+    }
+
+    std::unordered_map<std::string, long> CVODEIntegrator::currentSolverStatistics() const {
         std::unordered_map<std::string, long> s = {
                 {"steps", 0}, {"rhs_evals", 0}, {"rhs_evals_jac", 0}, {"jac_evals", 0}, {"nonlin_iters", 0},
                 {"nonlin_conv_fails", 0}, {"err_test_fails", 0}, {"lin_setups", 0},
@@ -1190,8 +1219,11 @@ namespace rr {
         if (CVodeGetNumLinSolvSetups(mCVODE_Memory, &v) == CV_SUCCESS) s["lin_setups"] = v;
         if (CVodeGetNumNonlinSolvIters(mCVODE_Memory, &v) == CV_SUCCESS) s["nonlin_iters"] = v;
         if (CVodeGetNumNonlinSolvConvFails(mCVODE_Memory, &v) == CV_SUCCESS) s["nonlin_conv_fails"] = v;
-        if (CVodeGetNumJacEvals(mCVODE_Memory, &v) == CV_SUCCESS) s["jac_evals"] = v;
-        if (CVodeGetNumLinRhsEvals(mCVODE_Memory, &v) == CV_SUCCESS) s["rhs_evals_jac"] = v;
+        // CVODE sets these to zero at the first step after a reinitialization
+        if (mLinearSolverCountersCurrent) {
+            if (CVodeGetNumJacEvals(mCVODE_Memory, &v) == CV_SUCCESS) s["jac_evals"] = v;
+            if (CVodeGetNumLinRhsEvals(mCVODE_Memory, &v) == CV_SUCCESS) s["rhs_evals_jac"] = v;
+        }
         return s;
     }
 
