"""Python-facing types for the SWIG API and its NumPy/container typemaps.

Keep these signatures aligned with roadrunner.i and the C++ headers. Matrices
use the default named-array configuration; disabling named matrices or enabling
structured simulation output changes their runtime array representation.
"""

from abc import abstractmethod
from collections.abc import Callable, Iterable, Iterator, Sequence
from typing import Generic, Literal, NoReturn, Protocol, TypeAlias, TypeVar, overload

import numpy as np
from numpy.typing import NDArray

from .named_array import NamedArray as NamedArray

_Setting: TypeAlias = str | bool | int | float | list[float] | None
_DictionaryLike: TypeAlias = Dictionary | dict[str, _Setting]
_FloatArray: TypeAlias = NDArray[np.float64]
_ComplexArray: TypeAlias = NDArray[np.complex128]
_FloatArrayLike: TypeAlias = (
    Sequence[float] | NDArray[np.floating | np.integer | np.bool_]
)
_IntArrayLike: TypeAlias = Sequence[int] | NDArray[np.integer] | IntVector
_SensitivityResult: TypeAlias = tuple[_FloatArray, _FloatArray, list[str], list[str]]
_EventCallback: TypeAlias = Callable[[ExecutableModel, int, str], int | None]
_IntegratorCallback: TypeAlias = Callable[
    [Integrator, ExecutableModel, float], int | None
]
_T = TypeVar("_T")

# Native APIs without a Python container typemap expose SWIG pointer handles.
# These are deliberately distinct from Python numbers, arrays and sequences.
class _SwigPointer(Protocol):
    def own(self, flag: bool = ..., /) -> bool: ...

SHARED_PTR_DISOWN: int
